+#!/usr/bin/env bash
+# Exercises .githooks/pre-commit in a throwaway repository. Run: bash tests/pre-commit.test.sh
+set -euo pipefail
+hook="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/.githooks/pre-commit"
+tmp="$(mktemp -d)"
+trap 'rm -rf "$tmp"' EXIT
+repo="$tmp/repo"
+git init -q "$repo"
+cd "$repo"
+git config user.email test@example.invalid
+git config user.name test
+fails=0
+
+# expect <exit-code> <description>: runs the hook against whatever is staged now.
+expect() {
+  local want="$1" desc="$2" got=0
+  bash "$hook" >"$tmp/out" 2>&1 || got=$?
+  if [[ "$got" == "$want" ]]; then
+    echo "ok   $desc"
+  else
+    echo "FAIL $desc: want exit $want, got $got"
+    sed 's/^/     /' "$tmp/out"
+    fails=$((fails + 1))
+  fi
+}
+unstage_all() { git read-tree --empty; }
+
+expect 0 "nothing staged"
+
+echo "hello" > plain.txt; git add plain.txt
+expect 0 "a plain file without TODOs"
+
+echo "x = 1 # TODO later" > todo.txt; git add todo.txt
+expect 0 "a TODO only warns"
+grep -q "new TODO/FIXME" "$tmp/out" || { echo "FAIL the TODO warning is missing"; fails=$((fails + 1)); }
+
+unstage_all; echo "API_URL=" > .env.example; git add .env.example
+expect 0 ".env.example is allowed"
+
+unstage_all; echo "A=1" > .env; git add -f .env
+expect 1 ".env is refused"
+
+unstage_all; mkdir -p app; echo "A=1" > app/.env.local; git add -f app/.env.local
+expect 1 "a nested .env.local is refused"
+
+unstage_all
+if (( fails == 0 )); then echo "pre-commit tests: all passed"; else echo "pre-commit tests: $fails failed"; exit 1; fi
