#!/usr/bin/env bash
# Runs before every commit. Enable once per clone: git config core.hooksPath .githooks
# Gates: no secrets staged, no env file staged, typecheck passes, Dockerfiles lint. TODOs only warn: the ledger is the issue tracker.
set -euo pipefail
staged=$(git diff --cached --name-only --diff-filter=ACM)

if command -v gitleaks >/dev/null 2>&1; then
  if gitleaks git --help >/dev/null 2>&1; then
    gitleaks git --pre-commit --staged --redact --no-banner      # gitleaks 8.19 and later
  else
    gitleaks protect --staged --redact --no-banner               # older releases
  fi
else
  echo "pre-commit: gitleaks is not installed (winget install Gitleaks.Gitleaks). Commit blocked: no secret scan, no commit." >&2
  exit 1
fi

if printf '%s\n' "$staged" | grep -E '(^|/)\.env(\.[^/]+)?$' | grep -vE '\.env\.example$' >/dev/null; then
  echo "pre-commit: refusing to commit an env file. Unstage it; values never enter git." >&2
  exit 1
fi

todos=$(git diff --cached -U0 | grep -E '^\+.*\b(TODO|FIXME|XXX)\b' | wc -l | tr -d ' ')
[[ "$todos" -gt 0 ]] && echo "pre-commit: $todos new TODO/FIXME line(s). File an issue and reference it, or remove them." >&2

if [ -f package.json ] && command -v pnpm >/dev/null 2>&1 && grep -q '"typecheck"' package.json; then
  pnpm typecheck
fi

while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  case "$(basename "$f")" in Dockerfile*) command -v hadolint >/dev/null 2>&1 && hadolint "$f" || true ;; esac
done <<< "$staged"
